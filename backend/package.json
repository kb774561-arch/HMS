    "test": "vitest run",
    "db:setup": "tsx src/scripts/setupLocalDb.ts",
    "db:menus": "tsx src/scripts/simplifyMenus.ts",
    "db:copy-supabase": "tsx src/scripts/copyFromSupabase.ts",
    "user:password": "tsx src/scripts/setUserPassword.ts",
    "test:bedops": "tsx tests/bedOperations.e2e.ts",
