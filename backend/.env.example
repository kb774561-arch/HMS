NODE_ENV=development
PORT=5000

# Local PostgreSQL (pgAdmin). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/genius_girls_pg
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/genius_girls_pg

# Supabase alternative — use the IPv4 *session pooler* (db.<ref>.supabase.co is IPv6-only):
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=8
# DIRECT_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173
JWT_SECRET=<GENERATE_SECURE_RANDOM_SECRET>
JWT_EXPIRES_IN=12h
