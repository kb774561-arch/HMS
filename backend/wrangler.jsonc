/**
 * Cloudflare Workers deploy config for Genius Girls PG API.
 * Root directory in Cloudflare dashboard must be: backend
 * Production branch: Development
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "genius-girls-pg-api",
	"main": "src/worker.ts",
	"compatibility_date": "2025-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	// Secrets (dashboard or `npx wrangler secret put <NAME>` — never commit):
	//   DATABASE_URL, DIRECT_URL, JWT_SECRET, FRONTEND_URL
	"vars": {
		"NODE_ENV": "production",
		"APP_TIMEZONE": "Asia/Kolkata",
		"JWT_EXPIRES_IN": "12h",
		"CF_WORKER": "1"
	}
}
